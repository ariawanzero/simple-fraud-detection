<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
      http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="ariawan">

        <createTable schemaName="fraud" tableName="transactions">

            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="account_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="card_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>

            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>

            <column name="merchant_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="country_code" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <createIndex
            indexName="idx_transactions_account"
            schemaName="fraud"
            tableName="transactions">
            <column name="account_id"/>
        </createIndex>

        <createIndex
            indexName="idx_transactions_card"
            schemaName="fraud"
            tableName="transactions">
            <column name="card_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>